# ──────────────────────────────────────────────────────────────────────────────
# Astro Portfolio — Production Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Public base URL of the portfolio site (used for internal API calls)
NEXT_PUBLIC_BASE_URL=https://your-domain.com

# Immich connection
# Option A: Immich on the same machine (via Docker host networking)
#   IMMICH_BASE_URL=http://host.docker.internal:2082
# Option B: Immich via public URL
#   IMMICH_BASE_URL=https://photos.yourdomain.com
IMMICH_BASE_URL=https://photos.yourdomain.com

# Immich API key (generate one in Immich → Admin → API Keys)
IMMICH_API_KEY=your-api-key-here

# Portfolio album — provide either the album ID or the album name (or both)
IMMICH_PORTFOLIO_ALBUM_ID=your-album-uuid-here
IMMICH_PORTFOLIO_ALBUM_NAME=Portfolio

# ── Failover (all optional) ──────────────────────────────────────────────────
# Order tried: primary Immich -> backup Immich -> local snapshot -> fallback folder.
#
# Backup Immich: point these at a second server during planned maintenance.
# Key and album default to the primary's values when omitted.
#IMMICH_BACKUP_BASE_URL=https://photos-backup.yourdomain.com
#IMMICH_BACKUP_API_KEY=
#IMMICH_BACKUP_PORTFOLIO_ALBUM_ID=
#IMMICH_BACKUP_PORTFOLIO_ALBUM_NAME=
#
# Snapshot: written automatically whenever Immich answers (thumbnails, previews
# and metadata). Served when no Immich is reachable. Mount it as a volume.
#SNAPSHOT_DIR=./.portfolio-snapshot
#
# Fallback folder: your own JPG/PNG/WEBP files, used only if there is no snapshot yet.
#FALLBACK_PHOTOS_DIR=./fallback-photos

# Set to "true" to disable server-side caching (useful during development)
# For production, keep this "false"
DISABLE_CACHE=false
